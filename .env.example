# Backend ready: set useMock to false and point at the API.
VITE_API_BASE_URL=http://localhost:5005/api/v1
# Optional; defaults to API host without /api/v1 (for /image/... uploads)
VITE_IMAGE_BASE_URL=http://localhost:5005
VITE_USE_MOCK=false

# Google Maps
VITE_GOOGLE_MAPS=

# Firebase (web push / FCM)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_DEFAULT_FCM_TOKEN=
